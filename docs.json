{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Plurex Docs",
  "colors": {
    "primary": "#ba54f5",
    "light": "#16C99D",
    "dark": "#0C9473"
  },
  "favicon": "/favicon.svg",
